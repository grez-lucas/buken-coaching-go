package templates

templ IndexPage() {
	@BaseLayout("LB Coaching - Asesorías") {
		@heroSectionMain()
		@featureSection("Asesorías 1:1", "Estrategia personalizada.", "Trabaja directamente con Coach Lucas, un especialista en transformaciones físicas con más de 6 años de experiencia. Su método basado en datos y disciplina asegura resultados medibles y sostenibles.", "/static/images/coach_buken_square.jpg", "/coaching", true)
		@featureSection("Método Elite", "Ciencia aplicada con disciplina.", "Utilizamos protocolos de entrenamiento de élite combinados con nutrición estratégica. Cada variable está calculada, cada progreso documentado, cada objetivo conquistado metódicamente.", "/static/images/program-collage.png", "/coaching", false)
		@transformationCarousel()
	}
}

// Tactical hero section with military-inspired design
templ heroSectionMain() {
	<section class="relative min-h-screen flex items-center justify-center text-white bg-cover bg-center bg-fixed" style="background-image: url('/static/images/buken-hero-2x.png');">
		<div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/70 to-black"></div>
		<!-- Tactical overlay for enhanced readability -->
		<div class="absolute inset-0 bg-black/30"></div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-5xl md:text-7xl font-extrabold uppercase tracking-wider mb-8 text-white">
				<span class="block font-light">LB</span>
				<span class="block text-tactical font-black">COACHING</span>
			</h1>
			<div class="w-16 h-px bg-tactical mx-auto mb-8"></div>
			<h2 class="text-lg md:text-xl font-semibold mb-6 text-gray-300 tracking-widest uppercase">
				Elite • Disciplina • Compromiso
			</h2>
			<p class="text-sm md:text-base max-w-2xl mx-auto mb-12 leading-relaxed text-gray-400 font-medium">
				Donde la <span class="text-tactical font-semibold">disciplina</span> encuentra la <span class="text-tactical font-semibold">ciencia deportiva</span>. 
				Transformaciones físicas ejecutadas con <span class="text-white font-semibold">precisión</span> y <span class="text-white font-semibold">compromiso total</span>.
			</p>
			<div class="flex flex-col sm:flex-row gap-6 justify-center">
				<a href="/coaching" class="group inline-block bg-tactical text-black font-bold py-4 px-10 uppercase tracking-wider border border-tactical hover:bg-transparent hover:text-tactical transition-all transform hover:scale-105">
					Comienza Tu Elite Journey
				</a>
				<a href="/appointments" class="group inline-block border border-white text-white font-bold py-4 px-10 uppercase tracking-wider hover:border-tactical hover:bg-tactical hover:text-black transition-all transform hover:scale-105">
					Consulta Gratuita
				</a>
			</div>
			<!-- Tactical line indicator -->
			<div class="absolute bottom-8 left-1/2 transform -translate-x-1/2">
				<div class="w-px h-12 bg-gradient-to-b from-tactical to-transparent"></div>
			</div>
		</div>
	</section>
}

// Tactical feature sections with military precision design
templ featureSection(title, subtitle, description, imageUrl, buttonLink string, imageLeft bool) {
	<section class="py-20 px-4 bg-black border-b border-gray-900/50">
		<div class="max-w-7xl mx-auto">
			if imageLeft {
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
					<div class="order-2 lg:order-1">
						<div class="relative group overflow-hidden">
							<img src={ templ.URL(imageUrl) } alt={ title } class="object-cover w-full h-[500px] transition-all duration-700 group-hover:scale-105"/>
							<div class="absolute inset-0 bg-black/40 group-hover:bg-black/10 transition-all duration-700"></div>
							<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
							<div class="absolute top-6 left-6">
								<div class="w-8 h-px bg-tactical"></div>
							</div>
						</div>
					</div>
					<div class="order-1 lg:order-2 text-white">
						<div class="max-w-lg">
							<div class="flex items-center mb-6">
								<div class="w-6 h-px bg-tactical mr-4"></div>
								<span class="text-tactical font-bold tracking-widest uppercase text-xs">Elite</span>
							</div>
							<h2 class="text-3xl md:text-4xl font-bold mb-4 tracking-tight">{ title }</h2>
							<p class="text-tactical text-lg font-semibold mb-6 tracking-wide">{ subtitle }</p>
							<p class="text-gray-400 leading-relaxed mb-8 font-medium">{ description }</p>
							<a href={ templ.URL(buttonLink) } class="inline-block border border-tactical text-tactical hover:bg-tactical hover:text-black font-bold py-3 px-8 uppercase tracking-wider transition-all transform hover:scale-105 group">
								<span class="flex items-center">
									Ver Más
									<svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
									</svg>
								</span>
							</a>
						</div>
					</div>
				</div>
			} else {
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
					<div class="text-white">
						<div class="max-w-lg">
							<div class="flex items-center mb-6">
								<div class="w-6 h-px bg-tactical mr-4"></div>
								<span class="text-tactical font-bold tracking-widest uppercase text-xs">Elite</span>
							</div>
							<h2 class="text-3xl md:text-4xl font-bold mb-4 tracking-tight">{ title }</h2>
							<p class="text-tactical text-lg font-semibold mb-6 tracking-wide">{ subtitle }</p>
							<p class="text-gray-400 leading-relaxed mb-8 font-medium">{ description }</p>
							<a href={ templ.URL(buttonLink) } class="inline-block border border-tactical text-tactical hover:bg-tactical hover:text-black font-bold py-3 px-8 uppercase tracking-wider transition-all transform hover:scale-105 group">
								<span class="flex items-center">
									Ver Más
									<svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
									</svg>
								</span>
							</a>
						</div>
					</div>
					<div>
						<div class="relative group overflow-hidden">
							<img src={ templ.URL(imageUrl) } alt={ title } class="object-cover w-full h-[500px] transition-all duration-700 group-hover:scale-105"/>
							<div class="absolute inset-0 bg-black/40 group-hover:bg-black/10 transition-all duration-700"></div>
							<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
							<div class="absolute top-6 right-6">
								<div class="w-8 h-px bg-tactical"></div>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	</section>
}

// Transformation carousel section with tactical styling
templ transformationCarousel() {
	<section class="py-20 px-4 bg-gray-900 border-b border-gray-900/50">
		<div class="max-w-7xl mx-auto">
			<!-- Section Header -->
			<div class="text-center mb-16">
				<div class="flex items-center justify-center mb-6">
					<div class="w-6 h-px bg-tactical mr-4"></div>
					<span class="text-tactical font-bold tracking-widest uppercase text-xs">Elite</span>
					<div class="w-6 h-px bg-tactical ml-4"></div>
				</div>
				<h2 class="text-3xl md:text-4xl font-bold mb-4 tracking-tight text-white">Transformaciones Reales</h2>
				<p class="text-tactical text-lg font-semibold mb-6 tracking-wide">Resultados verificables y medibles.</p>
				<p class="text-gray-400 leading-relaxed max-w-2xl mx-auto font-medium">
					Cada transformación representa meses de disciplina, ciencia aplicada y compromiso total.
					Estas son pruebas tangibles de lo que se puede lograr con el método correcto.
				</p>
			</div>
			<!-- Carousel Container -->
			<div x-data="{ activeSlide: 0, totalSlides: 3 }" class="relative max-w-6xl mx-auto">
				<!-- Carousel Images -->
				<div class="overflow-hidden rounded-lg">
					<div
						class="flex transition-transform duration-500 ease-in-out w-full"
						x-bind:style="`transform: translateX(-${activeSlide * 100}%)`"
					>
						<!-- Slide 1 -->
						<div class="w-full flex-shrink-0">
							<div class="bg-gray-800 p-6 md:p-8 mx-4 rounded-lg border border-gray-700/50">
								<img
									src="/static/images/transformation_1.png"
									alt="Transformación 1"
									class="w-full max-w-2xl mx-auto rounded-lg shadow-2xl"
								/>
								<div class="text-center mt-6">
									<div class="w-12 h-px bg-tactical mx-auto mb-4"></div>
									<p class="text-gray-300 text-sm tracking-wide">
										<span class="text-tactical font-semibold">Resultados en 20 semanas</span> - Fase de Ganancia Muscular
									</p>
								</div>
							</div>
						</div>
						<!-- Slide 2 -->
						<div class="w-full flex-shrink-0">
							<div class="bg-gray-800 p-6 md:p-8 mx-4 rounded-lg border border-gray-700/50">
								<img
									src="/static/images/transformation_2.png"
									alt="Transformación 2"
									class="w-full max-w-2xl mx-auto rounded-lg shadow-2xl"
								/>
								<div class="text-center mt-6">
									<div class="w-12 h-px bg-tactical mx-auto mb-4"></div>
									<p class="text-gray-300 text-sm tracking-wide">
										<span class="text-tactical font-semibold">Definición muscular elite</span> - Precisión en cada variable
									</p>
								</div>
							</div>
						</div>
						<!-- Slide 3 -->
						<div class="w-full flex-shrink-0">
							<div class="bg-gray-800 p-6 md:p-8 mx-4 rounded-lg border border-gray-700/50">
								<img
									src="/static/images/transformation_3.png"
									alt="Transformación 3"
									class="w-full max-w-2xl mx-auto rounded-lg shadow-2xl"
								/>
								<div class="text-center mt-6">
									<div class="w-12 h-px bg-tactical mx-auto mb-4"></div>
									<p class="text-gray-300 text-sm tracking-wide">
										<span class="text-tactical font-semibold">Composición corporal optimizada</span> - Método basado en datos
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!-- Navigation Arrows -->
				<button
					@click="activeSlide = activeSlide === 0 ? totalSlides - 1 : activeSlide - 1"
					class="absolute left-0 top-1/2 -translate-y-1/2 bg-black/70 hover:bg-tactical text-white hover:text-black p-3 rounded-full transition-all group z-10"
				>
					<svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path>
					</svg>
				</button>
				<button
					@click="activeSlide = activeSlide === totalSlides - 1 ? 0 : activeSlide + 1"
					class="absolute right-0 top-1/2 -translate-y-1/2 bg-black/70 hover:bg-tactical text-white hover:text-black p-3 rounded-full transition-all group z-10"
				>
					<svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
					</svg>
				</button>
				<!-- Dots Indicator -->
				<div class="flex justify-center mt-8 space-x-3">
					<template x-for="slide in totalSlides" :key="slide">
						<button
							@click="activeSlide = slide - 1"
							:class="activeSlide === slide - 1 ? 'bg-tactical' : 'bg-gray-600'"
							class="w-3 h-3 rounded-full transition-colors hover:bg-tactical/70"
						></button>
					</template>
				</div>
				<!-- CTA Button -->
				<div class="text-center mt-12">
					<a href="/appointments" class="inline-block border border-tactical text-tactical hover:bg-tactical hover:text-black font-bold py-4 px-10 uppercase tracking-wider transition-all transform hover:scale-105 group">
						<span class="flex items-center justify-center">
							Comienza Tu Transformación
							<svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
							</svg>
						</span>
					</a>
				</div>
			</div>
		</div>
	</section>
}
