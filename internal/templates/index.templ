package templates

templ IndexPage() {
	@BaseLayout("LB Coaching - Elite Fitness") {
		@heroSectionMain()
		@featureSection("Asesorías 1:1", "Trabaja directo con un experto.", "Trabaja directamente con Coach Lucas, un coach de élite con más de 6 años de experiencia y un historial comprobado de éxito global. Su enfoque meticuloso y basado en datos no deja ningún detalle sin optimizar, asegurando que cada variable esté optimizada para tu éxito.", "https://images.squarespace-cdn.com/content/v1/615e440d2b5cdc6d4c9e46b6/1697039206915-5SZ0W8HDQHHB8P0NL3YG/_DSC6270.jpg", "/coaching", true)
		@featureSection("Transformaciones Reales", "Resultados que hablan por sí mismos.", "Desde pérdida de grasa hasta preparación para competencias, nuestros clientes logran transformaciones extraordinarias. Cada programa está diseñado específicamente para tus objetivos, biotipo y estilo de vida.", "https://images.squarespace-cdn.com/content/v1/615e440d2b5cdc6d4c9e46b6/1697039335186-9R8RQ6TGCYW4Q0HIS1DH/_DSC6306.jpg", "/testimonials", false)
		@featureSection("Método Basado en Ciencia", "Donde la evidencia encuentra la práctica.", "Utilizamos los últimos avances en ciencias del deporte, nutrición y fisiología del ejercicio. Cada decisión está respaldada por investigación actualizada y adaptada a tu respuesta individual.", "https://images.squarespace-cdn.com/content/v1/615e440d2b5cdc6d4c9e46b6/1697039422863-MHZY7OJ8KRNPZW2SC5FD/_DSC6348.jpg", "/method", true)
	}
}

// Elite hero section with sharp black and neon green aesthetic
templ heroSectionMain() {
	<section class="relative min-h-screen flex items-center justify-center text-white bg-cover bg-center bg-fixed" style="background-image: url('https://images.squarespace-cdn.com/content/v1/615e440d2b5cdc6d4c9e46b6/8dad7c53-0b32-4b49-a6ef-17f2d9565372/_DSC6158.jpg');">
		<div class="absolute inset-0 bg-gradient-to-b from-black via-black/90 to-black"></div>
		<!-- Sharp geometric overlay -->
		<div class="absolute inset-0 bg-black/40"></div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-6xl md:text-8xl font-extrabold uppercase tracking-wider mb-6 text-white">
				<span class="block">LB</span>
				<span class="block text-neon">COACHING</span>
			</h1>
			<div class="w-20 h-1 bg-neon mx-auto mb-6 shadow-lg shadow-neon/50"></div>
			<h2 class="text-xl md:text-2xl font-light mb-8 text-gray-300 tracking-widest uppercase">
				Elite • Disciplina • Compromiso
			</h2>
			<p class="text-base md:text-lg max-w-2xl mx-auto mb-12 leading-relaxed text-gray-400">
				Donde la <span class="text-neon font-semibold">ciencia</span> encuentra la <span class="text-neon font-semibold">práctica</span>. Transformamos físicos a través de asesorías personalizadas y basadas en evidencia. Resultados <span class="text-white font-semibold">reales</span>, <span class="text-white font-semibold">medibles</span>, <span class="text-white font-semibold">elite</span>.
			</p>
			<div class="flex flex-col sm:flex-row gap-6 justify-center">
				<a href="/coaching" class="group inline-block bg-neon text-black font-bold py-4 px-10 uppercase tracking-wide border-2 border-neon hover:bg-transparent hover:text-neon transition-all transform hover:scale-105 shadow-lg shadow-neon/30">
					Comienza Tu Elite Journey
				</a>
				<a href="/appointments" class="group inline-block border-2 border-white text-white font-bold py-4 px-10 uppercase tracking-wide hover:border-neon hover:text-neon transition-all transform hover:scale-105">
					Consulta Estratégica
				</a>
			</div>
			<!-- Sharp scroll indicator -->
			<div class="absolute bottom-8 left-1/2 transform -translate-x-1/2">
				<div class="w-px h-16 bg-gradient-to-b from-neon to-transparent animate-bounce"></div>
			</div>
		</div>
	</section>
}

// Elite feature sections with sharp black/green design
templ featureSection(title, subtitle, description, imageUrl, buttonLink string, imageLeft bool) {
	<section class="py-24 px-4 bg-black border-b border-gray-900">
		<div class="max-w-7xl mx-auto">
			if imageLeft {
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
					<div class="order-2 lg:order-1">
						<div class="relative group">
							<img src={ templ.URL(imageUrl) } alt={ title } class="rounded-lg object-cover w-full h-[600px] filter grayscale hover:grayscale-0 transition-all duration-500"/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent rounded-lg"></div>
							<div class="absolute top-4 left-4">
								<div class="w-12 h-1 bg-neon"></div>
							</div>
						</div>
					</div>
					<div class="order-1 lg:order-2 text-white">
						<div class="max-w-lg">
							<div class="flex items-center mb-4">
								<div class="w-8 h-1 bg-neon mr-4"></div>
								<span class="text-neon font-bold tracking-widest uppercase text-sm">Elite</span>
							</div>
							<h2 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight">{ title }</h2>
							<p class="text-neon text-xl font-medium mb-6 tracking-wide">{ subtitle }</p>
							<p class="text-gray-400 leading-relaxed text-lg mb-8 font-light">{ description }</p>
							<a href={ templ.URL(buttonLink) } class="inline-block border border-neon text-neon hover:bg-neon hover:text-black font-bold py-3 px-8 uppercase tracking-wide transition-all transform hover:scale-105 group">
								<span class="flex items-center">
									Explorar
									<svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
									</svg>
								</span>
							</a>
						</div>
					</div>
				</div>
			} else {
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
					<div class="text-white">
						<div class="max-w-lg">
							<div class="flex items-center mb-4">
								<div class="w-8 h-1 bg-neon mr-4"></div>
								<span class="text-neon font-bold tracking-widest uppercase text-sm">Elite</span>
							</div>
							<h2 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight">{ title }</h2>
							<p class="text-neon text-xl font-medium mb-6 tracking-wide">{ subtitle }</p>
							<p class="text-gray-400 leading-relaxed text-lg mb-8 font-light">{ description }</p>
							<a href={ templ.URL(buttonLink) } class="inline-block border border-neon text-neon hover:bg-neon hover:text-black font-bold py-3 px-8 uppercase tracking-wide transition-all transform hover:scale-105 group">
								<span class="flex items-center">
									Explorar
									<svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
									</svg>
								</span>
							</a>
						</div>
					</div>
					<div>
						<div class="relative group">
							<img src={ templ.URL(imageUrl) } alt={ title } class="rounded-lg object-cover w-full h-[600px] filter grayscale hover:grayscale-0 transition-all duration-500"/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent rounded-lg"></div>
							<div class="absolute top-4 right-4">
								<div class="w-12 h-1 bg-neon"></div>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	</section>
}