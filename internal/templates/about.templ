package templates

templ AboutMe() {
	@BaseLayout("¿Quién soy?") {
		@aboutHeroSection()
		@aboutStorySection()
	}
}

// About hero section with coach portrait
templ aboutHeroSection() {
	<section class="relative py-20 bg-black border-b border-gray-900/50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div class="order-2 lg:order-1">
					<div class="relative group overflow-hidden">
						<img
							src="/static/images/buken-hero-2x.png"
							alt="Coach Lucas Buken"
							class="object-cover w-full h-[500px] contrast-110 brightness-105 saturate-110 group-hover:contrast-125 group-hover:brightness-110 group-hover:scale-105 transition-all duration-700 rounded-lg"
						/>
						<div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/50 to-transparent pointer-events-none"></div>
						<div class="absolute top-6 left-6">
							<div class="w-8 h-px bg-tactical"></div>
						</div>
					</div>
				</div>
				<div class="order-1 lg:order-2 text-white">
					<div class="max-w-lg">
						<div class="flex items-center mb-6">
							<div class="w-6 h-px bg-tactical mr-4"></div>
							<span class="text-tactical font-bold tracking-widest uppercase text-xs">Elite</span>
						</div>
						<h1 class="text-4xl md:text-5xl font-bold mb-6 tracking-tight">Lucas Grez</h1>
						<p class="text-tactical text-xl font-semibold mb-6 tracking-wide">Coach • Transformación Elite</p>
						<p class="text-gray-400 leading-relaxed mb-8 font-medium">
							6 años transformando cuerpos y vidas a través de ciencia aplicada, disciplina militar y compromiso total.
							Mi misión: ayudarte a evitar los errores que yo cometí.
						</p>
						<div class="flex items-center text-tactical text-sm mb-8">
							<div class="w-12 h-px bg-tactical mr-4"></div>
							<span class="tracking-widest uppercase font-semibold">Ingeniero • Coach • Estratega</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}

// Concise story section with timeline
templ aboutStorySection() {
	<section class="py-20 bg-gray-900">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<!-- Section Header -->
			<div class="text-center mb-16">
				<div class="flex items-center justify-center mb-6">
					<div class="w-6 h-px bg-tactical mr-4"></div>
					<span class="text-tactical font-bold tracking-widest uppercase text-xs">Elite Journey</span>
					<div class="w-6 h-px bg-tactical ml-4"></div>
				</div>
				<h2 class="text-3xl md:text-4xl font-bold mb-4 tracking-tight text-white">Mi Transformación</h2>
				<p class="text-tactical text-lg font-semibold tracking-wide">Del fracaso al método elite</p>
			</div>
			<!-- Timeline Grid -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Phase 1: Before -->
				<div class="text-center">
					<div class="relative group overflow-hidden mb-6">
						<img
							src="/static/images/about_1.JPG"
							alt="Antes del fitness"
							class="object-cover w-full h-80 contrast-110 brightness-105 saturate-110 group-hover:contrast-125 group-hover:brightness-110 transition-all duration-700 rounded-lg"
						/>
						<div class="absolute inset-0 bg-black/30 group-hover:bg-black/10 transition-all duration-700"></div>
						<div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/60 to-transparent"></div>
						<div class="absolute top-4 left-4">
							<span class="bg-tactical text-black text-xs font-bold px-2 py-1 rounded uppercase tracking-wider">Fase 1</span>
						</div>
					</div>
					<h3 class="text-xl font-bold text-white mb-3 tracking-tight">El Punto de Partida</h3>
					<p class="text-gray-400 text-sm leading-relaxed">
						Inseguridad, sobrepeso, errores por desinformación.
						<span class="text-tactical font-semibold">Los fracasos que me forjaron.</span>
					</p>
				</div>
				<!-- Phase 2: Journey -->
				<div class="text-center">
					<div class="relative group overflow-hidden mb-6">
						<img
							src="/static/images/about_2.jpg"
							alt="En el proceso"
							class="object-cover w-full h-80 contrast-110 brightness-105 saturate-110 group-hover:contrast-125 group-hover:brightness-110 transition-all duration-700 rounded-lg"
						/>
						<div class="absolute inset-0 bg-black/30 group-hover:bg-black/10 transition-all duration-700"></div>
						<div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/60 to-transparent"></div>
						<div class="absolute top-4 left-4">
							<span class="bg-tactical text-black text-xs font-bold px-2 py-1 rounded uppercase tracking-wider">Fase 2</span>
						</div>
					</div>
					<h3 class="text-xl font-bold text-white mb-3 tracking-tight">La Evolución</h3>
					<p class="text-gray-400 text-sm leading-relaxed">
						Aprendizaje constante, disciplina férrea, método científico.
						<span class="text-tactical font-semibold">Forjando el sistema elite.</span>
					</p>
				</div>
				<!-- Phase 3: Elite -->
				<div class="text-center">
					<div class="relative group overflow-hidden mb-6">
						<img
							src="/static/images/about_3.png"
							alt="Resultado elite"
							class="object-cover w-full h-80 contrast-110 brightness-105 saturate-110 group-hover:contrast-125 group-hover:brightness-110 transition-all duration-700 rounded-lg"
						/>
						<div class="absolute inset-0 bg-black/30 group-hover:bg-black/10 transition-all duration-700"></div>
						<div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/60 to-transparent"></div>
						<div class="absolute top-4 left-4">
							<span class="bg-tactical text-black text-xs font-bold px-2 py-1 rounded uppercase tracking-wider">Elite</span>
						</div>
					</div>
					<h3 class="text-xl font-bold text-white mb-3 tracking-tight">El Resultado</h3>
					<p class="text-gray-400 text-sm leading-relaxed">
						6 años de experiencia, método probado, resultados verificables.
						<span class="text-tactical font-semibold">Listo para transferir conocimiento.</span>
					</p>
				</div>
			</div>
			<!-- Mission Statement -->
			<div class="mt-6 text-center">
				<div class="bg-gray-800 py-5 md:p-10 rounded-lg border border-gray-700/50 max-w-4xl mx-auto">
					<div class="w-16 h-px bg-tactical mx-auto mb-6"></div>
					<h3 class="text-2xl md:text-3xl font-bold text-white mb-6 tracking-tight">Mi Misión</h3>
					<p class="text-gray-300 text-lg leading-relaxed mb-8">
						<span class="text-tactical font-semibold">No estoy aquí para venderte píldoras mágicas.</span>
						El camino es duro, pero lo que es más duro es darte cuenta 5 años después que pudiste lograr mucho más
						con el mismo tiempo y esfuerzo.
					</p>
					<p class="text-white text-xl font-semibold mb-8 tracking-wide">
						Déjame ayudarte a <span class="text-tactical">saltar mis errores</span> y alcanzar tu verdadero potencial.
					</p>
					<!-- CTA Buttons -->
					<div class="flex flex-col sm:flex-row gap-4 justify-center">
						<a href="/appointments" class="bg-tactical text-black font-bold py-4 px-8 uppercase tracking-wider hover:bg-tactical/90 transition-all transform hover:scale-105 rounded">
							Agenda tu Consulta Gratuita
						</a>
						<a href="/coaching" class="border border-tactical text-tactical hover:bg-tactical hover:text-black font-bold py-4 px-8 uppercase tracking-wider transition-all transform hover:scale-105 rounded">
							Asesoría Elite 1:1
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
}
