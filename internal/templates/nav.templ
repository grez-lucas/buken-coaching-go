package templates

templ Header() {
	<header class="bg-black border-b border-green-800/40 sticky top-0 z-50 backdrop-blur-sm bg-black/98">
		<nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" x-data="{ mobileMenuOpen: false }">
			<div class="flex justify-between items-center h-16">
				<!-- Logo - Left on desktop, center on mobile -->
				<div class="flex-shrink-0 md:flex-shrink md:flex-grow-0">
					<a href="/" class="block group">
						<img src="/static/images/logo.png" alt="LB Coaching Logo" class="h-12 w-auto transition-transform group-hover:scale-105"/>
					</a>
				</div>
				
				<!-- Desktop Menu - Right aligned -->
				<div class="hidden md:flex items-center space-x-8">
					<a href="/" class="text-gray-300 hover:text-tactical transition-colors font-medium tracking-wider uppercase text-sm">Inicio</a>
					<a href="/about" class="text-gray-300 hover:text-tactical transition-colors font-medium tracking-wider uppercase text-sm">¿Quién soy?</a>
					<a href="/coaching" class="text-gray-300 hover:text-tactical transition-colors font-medium tracking-wider uppercase text-sm">Asesorías</a>
					<a href="/appointments" class="px-6 py-2 border border-tactical text-tactical hover:bg-tactical hover:text-black transition-all font-semibold tracking-wider uppercase text-sm">
						Consulta
					</a>
				</div>
				
				<!-- Mobile menu button -->
				<div class="md:hidden">
					<button 
						type="button" 
						class="text-gray-300 hover:text-tactical focus:outline-none focus:text-tactical transition-colors"
						@click="mobileMenuOpen = !mobileMenuOpen"
						:aria-expanded="mobileMenuOpen"
						aria-controls="mobile-menu"
					>
						<span class="sr-only">Abrir menú principal</span>
						<!-- Hamburger icon -->
						<svg x-show="!mobileMenuOpen" class="h-6 w-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
						</svg>
						<!-- Close icon -->
						<svg x-show="mobileMenuOpen" x-cloak class="h-6 w-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
			</div>
			
			<!-- Mobile menu panel -->
			<div 
				class="md:hidden"
				id="mobile-menu"
				x-show="mobileMenuOpen"
				x-cloak
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="opacity-0 transform -translate-y-2"
				x-transition:enter-end="opacity-100 transform translate-y-0"
				x-transition:leave="transition ease-in duration-150"
				x-transition:leave-start="opacity-100 transform translate-y-0"
				x-transition:leave-end="opacity-0 transform -translate-y-2"
			>
				<div class="px-2 pt-2 pb-3 space-y-1 bg-gray-900 border-t border-green-800/20">
					<a href="/" class="block px-3 py-3 text-gray-300 hover:text-tactical hover:bg-gray-800 rounded text-base font-medium tracking-wider uppercase transition-all">
						Inicio
					</a>
					<a href="/about" class="block px-3 py-3 text-gray-300 hover:text-tactical hover:bg-gray-800 rounded text-base font-medium tracking-wider uppercase transition-all">
						¿Quién soy?
					</a>
					<a href="/coaching" class="block px-3 py-3 text-gray-300 hover:text-tactical hover:bg-gray-800 rounded text-base font-medium tracking-wider uppercase transition-all">
						Asesorías
					</a>
					<a href="/appointments" class="block px-3 py-3 border border-tactical text-tactical hover:bg-tactical hover:text-black rounded text-base font-semibold tracking-wider uppercase transition-all text-center mt-2">
						Consulta
					</a>
				</div>
			</div>
		</nav>
	</header>
}