package templates

templ Appointments() {
	@BaseLayout("Agenda tu Consulta") {
		@appointmentHeroSection()
		@smartSchedulingForm()
	}
}

templ appointmentHeroSection() {
	<section class="relative py-20 bg-black border-b border-gray-900/50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<div class="flex items-center justify-center mb-6">
				<div class="w-6 h-px bg-tactical mr-4"></div>
				<span class="text-tactical font-bold tracking-widest uppercase text-xs">Elite Consultation</span>
				<div class="w-6 h-px bg-tactical ml-4"></div>
			</div>
			<h1 class="text-4xl md:text-5xl font-bold mb-6 tracking-tight text-white">
				Consulta Gratuita
			</h1>
			<p class="text-tactical text-xl font-semibold mb-8 tracking-wide">
				Primera evaluación • Sin compromiso • Estrategia personalizada
			</p>
			<p class="text-gray-400 leading-relaxed mb-8 font-medium max-w-3xl mx-auto">
				Esta consulta me permite entender tu situación actual, objetivos y nivel de compromiso.
				Solo trabajo con personas <span class="text-tactical font-semibold">100% comprometidas</span> con su transformación.
			</p>
		</div>
	</section>
}

templ smartSchedulingForm() {
	<section class="py-20 bg-gray-900">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<div
				x-data="{
					step: 1,
					loading: false,
					formData: {
						name: '',
						email: '',
						phone: '',
						goal: '',
						timeframe: '',
						commitment: null,
						experience: ''
					},
					qualified: false,
					async submitForm() {
						this.loading = true;

						try {
							// Send form data to backend
							const formData = new FormData();
							formData.append('name', this.formData.name);
							formData.append('email', this.formData.email);
							formData.append('phone', this.formData.phone);
							formData.append('goal', this.formData.goal);
							formData.append('timeframe', this.formData.timeframe);
							formData.append('commitment', this.formData.commitment.toString());
							formData.append('experience', this.formData.experience);

							const response = await fetch('/api/appointments', {
								method: 'POST',
								body: formData
							});

							if (response.ok) {
								this.qualified = this.formData.commitment >= 8;
								this.step = 2;
							} else {
								const errorText = await response.text();
								console.error('Form submission failed:', errorText);
								if (response.status === 400) {
									alert('Por favor, completa todos los campos requeridos correctamente.');
								} else {
									alert('Error al enviar el formulario. Por favor, intenta de nuevo.');
								}
							}
						} catch (error) {
							console.error('Network error:', error);
							alert('Error de conexión. Por favor, intenta de nuevo.');
						} finally {
							this.loading = false;
						}
					},
					resetForm() {
						this.step = 1;
						this.qualified = false;
						this.formData = {
							name: '',
							email: '',
							phone: '',
							goal: '',
							timeframe: '',
							commitment: null,
							experience: ''
						};
					}
				}"
				class="bg-gray-800 rounded-lg border border-gray-700/50 p-8 md:p-12"
			>
				<!-- Step 1: Qualification Form -->
				<div x-show="step === 1" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform scale-95" x-transition:enter-end="opacity-100 transform scale-100">
					<div class="text-center mb-8">
						<div class="w-16 h-px bg-tactical mx-auto mb-6"></div>
						<h2 class="text-3xl font-bold text-white mb-4 tracking-tight">Evaluación Inicial</h2>
						<p class="text-gray-400">Completa este formulario para determinar si eres candidato para asesoría elite</p>
					</div>
					<form @submit.prevent="submitForm()" class="space-y-6">
						<!-- Basic Info -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<div>
								<label class="block text-tactical font-semibold mb-2 uppercase tracking-wide text-sm">Nombre Completo *</label>
								<input
									x-model="formData.name"
									type="text"
									required
									class="w-full bg-gray-700 border border-gray-600 text-white p-4 rounded focus:border-tactical focus:outline-none"
									placeholder="Tu nombre completo"
								/>
							</div>
							<div>
								<label class="block text-tactical font-semibold mb-2 uppercase tracking-wide text-sm">Email *</label>
								<input
									x-model="formData.email"
									type="email"
									required
									class="w-full bg-gray-700 border border-gray-600 text-white p-4 rounded focus:border-tactical focus:outline-none"
									placeholder="tu@email.com"
								/>
							</div>
						</div>
						<div>
							<label class="block text-tactical font-semibold mb-2 uppercase tracking-wide text-sm">Teléfono *</label>
							<input
								x-model="formData.phone"
								type="tel"
								required
								class="w-full bg-gray-700 border border-gray-600 text-white p-4 rounded focus:border-tactical focus:outline-none"
								placeholder="+56 9 1234 5678"
							/>
						</div>
						<!-- Goals & Timeline -->
						<div>
							<label class="block text-tactical font-semibold mb-2 uppercase tracking-wide text-sm">Objetivo Principal *</label>
							<select
								x-model="formData.goal"
								required
								class="w-full bg-gray-700 border border-gray-600 text-white p-4 rounded focus:border-tactical focus:outline-none"
							>
								<option value="">Selecciona tu objetivo</option>
								<option value="fat-loss">Pérdida de grasa</option>
								<option value="muscle-gain">Ganancia muscular</option>
								<option value="strength">Aumento de fuerza</option>
								<option value="recomposition">Recomposición corporal</option>
								<option value="performance">Rendimiento atlético</option>
								<option value="lifestyle">Cambio de estilo de vida</option>
							</select>
						</div>
						<div>
							<label class="block text-tactical font-semibold mb-2 uppercase tracking-wide text-sm">¿En cuánto tiempo quieres ver resultados? *</label>
							<select
								x-model="formData.timeframe"
								required
								class="w-full bg-gray-700 border border-gray-600 text-white p-4 rounded focus:border-tactical focus:outline-none"
							>
								<option value="">Selecciona timeframe</option>
								<option value="3-months">3 meses</option>
								<option value="6-months">6 meses</option>
								<option value="12-months">12 meses</option>
								<option value="long-term">Más de 12 meses</option>
							</select>
						</div>
						<div>
							<label class="block text-tactical font-semibold mb-2 uppercase tracking-wide text-sm">Experiencia previa</label>
							<select
								x-model="formData.experience"
								class="w-full bg-gray-700 border border-gray-600 text-white p-4 rounded focus:border-tactical focus:outline-none"
							>
								<option value="">Selecciona tu nivel</option>
								<option value="beginner">Principiante (0-1 año)</option>
								<option value="intermediate">Intermedio (1-3 años)</option>
								<option value="advanced">Avanzado (3+ años)</option>
								<option value="athlete">Atleta/Competidor</option>
							</select>
						</div>
						<!-- Critical Question: Commitment Scale -->
						<div class="border-t border-gray-700 pt-8">
							<label class="block text-tactical font-bold mb-4 uppercase tracking-wide text-sm">
								PREGUNTA CLAVE: Nivel de Compromiso *
							</label>
							<p class="text-gray-300 mb-6 leading-relaxed">
								Del 1 al 10, siendo 10 "estoy dispuesto a seguir el plan al 100%, sin excusas, durante los próximos 6 meses",
								¿cuál es tu nivel de compromiso real?
							</p>
							<div class="grid grid-cols-5 md:grid-cols-10 gap-2">
								<template x-for="i in 10" :key="i">
									<button
										type="button"
										@click="formData.commitment = i"
										:class="formData.commitment === i ? 'bg-tactical text-black' : 'bg-gray-700 text-white hover:bg-gray-600'"
										class="aspect-square flex items-center justify-center font-bold text-lg rounded transition-all transform hover:scale-105"
									>
										<span x-text="i"></span>
									</button>
								</template>
							</div>
							<div class="flex justify-between text-xs text-gray-500 mt-2">
								<span>Sin compromiso</span>
								<span>Compromiso total</span>
							</div>
						</div>
						<!-- Submit Button -->
						<div class="text-center pt-6">
							<button
								type="submit"
								:disabled="!formData.commitment || loading"
								:class="(formData.commitment && !loading) ? 'bg-tactical hover:bg-tactical/90' : 'bg-gray-600 cursor-not-allowed'"
								class="text-black font-bold py-4 px-8 uppercase tracking-wider transition-all transform hover:scale-105 rounded disabled:transform-none disabled:hover:bg-gray-600"
							>
								<span x-show="!loading">Evaluar Candidatura</span>
								<span x-show="loading">Enviando...</span>
							</button>
						</div>
					</form>
				</div>
				<!-- Step 2: Results -->
				<div x-show="step === 2" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform scale-95" x-transition:enter-end="opacity-100 transform scale-100">
					<!-- High Commitment: Immediate Booking -->
					<div x-show="qualified" class="text-center">
						<div class="w-16 h-px bg-tactical mx-auto mb-6"></div>
						<div class="mb-8">
							<div class="inline-flex items-center bg-green-900/50 border border-green-700 text-green-400 px-4 py-2 rounded-full mb-4">
								<span class="w-2 h-2 bg-green-400 rounded-full mr-2"></span>
								<span class="font-semibold uppercase tracking-wide text-xs">Candidato Calificado</span>
							</div>
							<h2 class="text-3xl font-bold text-white mb-4 tracking-tight">
								¡Excelente! Puedes agendar ahora
							</h2>
							<p class="text-gray-400 mb-8 max-w-2xl mx-auto">
								Tu nivel de compromiso (<span class="text-tactical font-bold" x-text="formData.commitment"></span>/10) indica que estás listo para una asesoría elite.
								Agenda tu consulta gratuita de 30 minutos directamente en mi calendario.
							</p>
						</div>
						<!-- Google Calendar Integration -->
						<div class="bg-light p-4 md:p-6 rounded-lg border border-gray-600 mb-6">
							<h3 class="text-white font-bold mb-4 uppercase tracking-wide text-center">Agenda tu consulta</h3>
							<!-- Google Calendar iframe container -->
							<div class="relative bg-white rounded-lg overflow-hidden shadow-xl">
								<!-- Mobile optimization wrapper -->
								<div class="w-full" style="position: relative; padding-bottom: 75%; height: 0; min-height: 500px;">
									<iframe
										src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ0URxqmicDMS4kgGh-OjaQ_5_OfcudzaJt38bxfLL8mYDPwypStXyfVfGIuv2FAMkUWpRVjGezV?gv=true"
										style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; border-radius: 8px;"
										frameborder="0"
										loading="lazy"
										title="Agenda tu consulta con LB Coaching"
									></iframe>
								</div>
							</div>
							<!-- Mobile-specific instructions -->
							<div class="mt-4 text-center text-gray-400 text-sm md:hidden">
								<p>💡 Para mejor experiencia en móvil, gira tu dispositivo horizontalmente</p>
							</div>
						</div>
						<button
							@click="resetForm()"
							class="text-tactical hover:text-white border border-tactical hover:bg-tactical/20 font-semibold py-2 px-6 rounded transition-all"
						>
							← Volver al formulario
						</button>
					</div>
					<!-- Low Commitment: Manual Review -->
					<div x-show="!qualified" class="text-center">
						<div class="w-16 h-px bg-yellow-500 mx-auto mb-6"></div>
						<div class="mb-8">
							<div class="inline-flex items-center bg-yellow-900/50 border border-yellow-700 text-yellow-400 px-4 py-2 rounded-full mb-4">
								<span class="w-2 h-2 bg-yellow-400 rounded-full mr-2"></span>
								<span class="font-semibold uppercase tracking-wide text-xs">En Revisión</span>
							</div>
							<h2 class="text-3xl font-bold text-white mb-4 tracking-tight">
								Te contactaremos pronto
							</h2>
							<p class="text-gray-400 mb-8 max-w-2xl mx-auto">
								Tu nivel de compromiso (<span class="text-yellow-400 font-bold" x-text="formData.commitment"></span>/10) requiere una evaluación más detallada.
								Te contactaré dentro de las próximas <span class="text-white font-semibold">24 horas</span> para determinar si mi asesoría es adecuada para ti.
							</p>
						</div>
						<div class="bg-gray-700 p-6 rounded-lg border border-gray-600 mb-6">
							<h3 class="text-yellow-400 font-bold mb-4 uppercase tracking-wide">¿Por qué necesito revisar tu caso?</h3>
							<div class="text-left text-gray-300 space-y-3">
								<p class="flex items-start">
									<span class="text-yellow-400 mr-2">•</span>
									Mi asesoría requiere compromiso total durante mínimo 6 meses
								</p>
								<p class="flex items-start">
									<span class="text-yellow-400 mr-2">•</span>
									Los mejores resultados los obtienen personas con mentalidad de atleta
								</p>
								<p class="flex items-start">
									<span class="text-yellow-400 mr-2">•</span>
									Prefiero evaluar si puedes aumentar tu nivel de compromiso antes de comenzar
								</p>
							</div>
						</div>
						<div class="space-y-4">
							<p class="text-tactical font-semibold">
								Revisa tu email en las próximas horas
							</p>
							<button
								@click="resetForm()"
								class="text-tactical hover:text-white border border-tactical hover:bg-tactical/20 font-semibold py-2 px-6 rounded transition-all"
							>
								← Intentar nuevamente
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}
